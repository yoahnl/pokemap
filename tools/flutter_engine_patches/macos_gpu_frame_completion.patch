+
+TEST(FlutterSurfaceManager, WaitsForGPUCompletionBeforePresentationAndNotification) {
+  id device = OCMProtocolMock(@protocol(MTLDevice));
+  id queue = OCMProtocolMock(@protocol(MTLCommandQueue));
+  id commandBuffer = OCMProtocolMock(@protocol(MTLCommandBuffer));
+  id delegate = OCMProtocolMock(@protocol(FlutterSurfaceManagerDelegate));
+  NSMutableArray<NSString*>* events = [NSMutableArray array];
+  __block bool committed = false;
+  __block bool completed = false;
+  __block bool notified = false;
+
+  OCMStub([queue commandBuffer]).andReturn(commandBuffer);
+  OCMExpect([commandBuffer commit]).andDo(^(NSInvocation* invocation) {
+    (void)invocation;
+    committed = true;
+    [events addObject:@"commit"];
+  });
+  OCMStub([commandBuffer waitUntilScheduled]).andDo(^(NSInvocation* invocation) {
+    (void)invocation;
+    EXPECT_TRUE(committed);
+    [events addObject:@"scheduled"];
+  });
+  OCMExpect([commandBuffer waitUntilCompleted]).andDo(^(NSInvocation* invocation) {
+    (void)invocation;
+    EXPECT_TRUE(committed);
+    completed = true;
+    [events addObject:@"completed"];
+  });
+  OCMStub([delegate onPresent:CGSizeZero withBlock:[OCMArg any] delay:0])
+      .andDo(^(NSInvocation* invocation) {
+        EXPECT_TRUE(completed);
+        [events addObject:@"present"];
+        __unsafe_unretained dispatch_block_t presentBlock;
+        [invocation getArgument:&presentBlock atIndex:3];
+        presentBlock();
+      });
+
+  FlutterSurfaceManager* manager = [[FlutterSurfaceManager alloc]
+      initWithDevice:device
+        commandQueue:queue
+               layer:[CALayer layer]
+            delegate:delegate
+           wideGamut:NO];
+  [manager presentSurfaces:@[]
+                    atTime:0
+                    notify:^{
+                      EXPECT_TRUE(completed);
+                      notified = true;
+                      [events addObject:@"notify"];
+                    }];
+
+  EXPECT_TRUE(notified);
+  EXPECT_TRUE(([events isEqualToArray:@[ @"commit", @"completed", @"present", @"notify" ]]));
+  @try {
+    [commandBuffer verify];
+  } @catch (NSException* exception) {
+    ADD_FAILURE() << exception.reason.UTF8String;
+  }
 }
 
