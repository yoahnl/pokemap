{
  "name": "@pokemap/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local MCP adapter for the canonical PokeMap authoring API.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/src/index.js",
    "verify:checkout-catalog": "npm run build && node dist/src/checkout_catalog_verifier.js",
    "test": "npm run build && node --import tsx --test --test-concurrency=1 test/**/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@modelcontextprotocol/core": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "zod": "4.2.0"
  },
  "devDependencies": {
    "@types/node": "26.1.2",
    "tsx": "4.23.1",
    "typescript": "7.0.2"
  }
}
