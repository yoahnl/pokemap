          ]
        },
        {
          "actionId": "world_rule.update",
          "actionVersion": 1,
          "parameters": {"rule": {"id": "world_rule_weekend_guide", "label": "Weekend guide", "priority": 10, "source": {"kind": "civilWeekday", "sourceId": "civilWeekday", "predicate": "isTrue", "weekday": "saturday"}, "target": {"kind": "mapEntity", "mapId": "map", "entityId": "old-guide"}, "effect": {"kind": "entityHidden"}}},
          "observations": [
            {"path": "project.json", "at": ["worldRules", 0, "effect", "kind"], "equals": "entityHidden"},
