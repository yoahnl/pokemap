          ]
        },
        {
          "actionId": "presentationVisualFolder.create",
          "actionVersion": 1,
          "parameters": {"cinematicId": "opening", "folderId": "terrain", "label": "Terrain"},
          "observations": [
            {"path": "project.json", "at": ["presentationCinematics", 0, "visualFolders", 1, "id"], "equals": "terrain"}
          ]
        },
        {
          "actionId": "presentationVisualFolder.update",
          "actionVersion": 1,
          "parameters": {"cinematicId": "opening", "folderId": "characters", "label": "Characters"},
          "observations": [
            {"path": "project.json", "at": ["presentationCinematics", 0, "visualFolders", 0, "label"], "equals": "Characters"}
          ]
        },
        {
          "actionId": "presentationVisualFolder.setVisibility",
          "actionVersion": 1,
          "parameters": {"cinematicId": "opening", "folderId": "characters", "visible": false},
          "observations": [
            {"path": "project.json", "at": ["presentationCinematics", 0, "visualFolders", 0, "hidden"], "equals": true}
          ]
        },
        {
          "actionId": "presentationVisualFolder.setLocked",
          "actionVersion": 1,
          "parameters": {"cinematicId": "opening", "folderId": "characters", "locked": true},
          "observations": [
            {"path": "project.json", "at": ["presentationCinematics", 0, "visualFolders", 0, "locked"], "equals": true}
          ]
        },
        {
          "actionId": "presentationVisualFolder.move",
          "actionVersion": 1,
          "parameters": {"cinematicId": "opening", "folderId": "characters", "insertionIndex": 1},
          "observations": [
            {"path": "project.json", "at": ["presentationCinematics", 0, "layers", 0, "id"], "equals": "background"},
