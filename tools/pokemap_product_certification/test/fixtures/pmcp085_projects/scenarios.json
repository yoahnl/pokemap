{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "campaign-content",
      "projectRoot": "campaign-content",
      "steps": [
        {
          "actionId": "campaign.badge.upsert",
          "actionVersion": 1,
          "parameters": {"value": {"id": "trail", "label": "Trail badge"}},
          "observations": [
            {"path": "project.json", "at": ["badges", 0, "label"], "equals": "Trail badge"}
          ]
        },
        {
          "actionId": "campaign.badge.delete",
          "actionVersion": 1,
          "confirm": true,
          "parameters": {"id": "trail"},
          "observations": [
            {"path": "project.json", "at": ["badges"], "equals": []}
          ]
        },
        {
          "actionId": "campaign.character.upsert",
          "actionVersion": 1,
          "parameters": {"value": {"id": "guide", "name": "Guide", "tilesetId": "proof"}},
          "observations": [
            {"path": "project.json", "at": ["characters", 1, "id"], "equals": "guide"},
            {"path": "project.json", "at": ["characters", 1, "tilesetId"], "equals": "proof"}
          ]
        },
        {
          "actionId": "campaign.character.delete",
          "actionVersion": 1,
          "confirm": true,
          "parameters": {"id": "guide"},
          "observations": [
            {"path": "project.json", "at": ["characters", 0, "id"], "equals": "ranger"},
            {"path": "project.json", "at": ["characters", 1], "absent": true}
          ]
        },
        {
          "actionId": "campaign.shop.upsert",
          "actionVersion": 1,
          "parameters": {"value": {"id": "hiker-shop", "label": "Hiker shop"}},
          "observations": [
            {"path": "project.json", "at": ["shops", 0, "label"], "equals": "Hiker shop"}
          ]
        },
        {
          "actionId": "campaign.shop.delete",
          "actionVersion": 1,
          "confirm": true,
          "parameters": {"id": "hiker-shop"},
          "observations": [
            {"path": "project.json", "at": ["shops"], "equals": []}
          ]
        },
        {
          "actionId": "campaign.trainer.upsert",
          "actionVersion": 1,
          "parameters": {"value": {"id": "hiker", "name": "Hiker", "trainerClass": "Ranger"}},
          "observations": [
            {"path": "project.json", "at": ["trainers", 0, "trainerClass"], "equals": "Ranger"}
          ]
        },
        {
          "actionId": "campaign.trainer.delete",
          "actionVersion": 1,
          "confirm": true,
          "parameters": {"id": "hiker"},
          "observations": [
            {"path": "project.json", "at": ["trainers"], "equals": []}
          ]
        },
        {
          "actionId": "campaign.trainer.upsert_batch",
          "actionVersion": 1,
          "parameters": {"values": [{"id": "coach", "name": "Coach", "trainerClass": "Trainer"}, {"id": "guard", "name": "Guard", "trainerClass": "Ranger"}]},
          "observations": [
            {"path": "project.json", "at": ["trainers", 0, "id"], "equals": "coach"},
            {"path": "project.json", "at": ["trainers", 1, "id"], "equals": "guard"}
          ]
        },
        {
          "actionId": "campaign.encounter_table.upsert_batch",
          "actionVersion": 1,
          "parameters": {"values": [{"id": "hill", "name": "Hill", "encounterKind": "walk", "entries": [{"speciesId": "sproutle", "minLevel": 3, "maxLevel": 5}]}, {"id": "river", "name": "River", "encounterKind": "surf", "entries": [{"speciesId": "brookling", "minLevel": 4, "maxLevel": 6}]}]},
          "observations": [
            {"path": "project.json", "at": ["encounterTables", 0, "entries", 0, "minLevel"], "equals": 3},
            {"path": "project.json", "at": ["encounterTables", 1, "encounterKind"], "equals": "surf"}
          ]
        },
        {
          "actionId": "campaign.new_game.update",
          "actionVersion": 1,
          "parameters": {"newGame": {"enabled": true, "startMapId": "map", "initialRecoveryPoint": {"mapId": "map", "position": {"x": 2, "y": 1}, "facing": "east"}}},
          "observations": [
            {"path": "project.json", "at": ["newGame", "startMapId"], "equals": "map"},
            {"path": "project.json", "at": ["newGame", "initialRecoveryPoint"], "equals": {"mapId": "map", "position": {"x": 2, "y": 1}, "facing": "east"}}
          ]
        }
      ]
    },
    {
      "id": "pokemon-documents-write",
      "projectRoot": "pokemon-documents-write",
      "steps": [
        {
          "actionId": "pokemon.catalog.write",
          "actionVersion": 1,
          "parameters": {"relativePath": "data/pokemon/catalogs/moves.json", "beforeBytesBase64": "ewogICJzY2hlbWFWZXJzaW9uIjogMSwKICAia2luZCI6ICJwb2tlbW9uX2NhdGFsb2ciLAogICJjYXRhbG9nIjogIm1vdmVzIiwKICAiZW50cmllcyI6IFsKICAgIHsKICAgICAgImlkIjogImVjaG8iLAogICAgICAicG93ZXIiOiAzNSwKICAgICAgImFjY3VyYWN5IjogMTAwCiAgICB9CiAgXQp9Cg==", "document": {"schemaVersion": 1, "kind": "pokemon_catalog", "catalog": "moves", "entries": [{"id": "echo", "power": 35, "accuracy": 100}, {"id": "chime", "power": 45, "accuracy": 100}]}},
          "observations": [
            {"path": "data/pokemon/catalogs/moves.json", "at": ["entries", 1, "id"], "equals": "chime"}
          ]
        },
        {
          "actionId": "pokemon.catalog.entries.add",
          "actionVersion": 1,
          "parameters": {"relativePath": "data/pokemon/catalogs/moves.json", "entries": [{"id": "crescendo", "power": 60, "accuracy": 90}]},
          "observations": [
            {"path": "data/pokemon/catalogs/moves.json", "at": ["entries", 0, "id"], "equals": "echo"},
            {"path": "data/pokemon/catalogs/moves.json", "at": ["entries", 2, "id"], "equals": "crescendo"}
          ]
        },
        {
          "actionId": "pokemon.species.write",
          "actionVersion": 1,
          "parameters": {"relativePath": "data/pokemon/species/sprout.json", "document": {"schemaVersion": 1, "id": "sprout", "name": {"en": "Sprout"}, "typing": {"types": ["grass"]}, "baseStats": {"hp": 48, "atk": 47, "def": 46, "spa": 45, "spd": 44, "spe": 43}, "abilities": {"primary": "chord"}, "progression": {"growthRateId": "medium_slow", "baseExp": 60, "catchRate": 100}}},
          "observations": [
            {"path": "data/pokemon/species/sprout.json", "at": ["id"], "equals": "sprout"},
            {"path": "data/pokemon/species/sprout.json", "at": ["baseStats", "atk"], "equals": 47}
          ]
        },
        {
          "actionId": "pokemon.learnset.write",
          "actionVersion": 1,
          "parameters": {"relativePath": "data/pokemon/learnsets/sprout.json", "document": {"schemaVersion": 1, "speciesId": "sprout", "levelUp": [{"moveId": "chime", "level": 4}]}},
          "observations": [
            {"path": "data/pokemon/learnsets/sprout.json", "at": ["levelUp", 0, "moveId"], "equals": "chime"},
            {"path": "data/pokemon/learnsets/sprout.json", "at": ["levelUp", 0, "level"], "equals": 4}
          ]
        },
        {
          "actionId": "pokemon.evolution.write",
          "actionVersion": 1,
          "parameters": {"relativePath": "data/pokemon/evolutions/sprout.json", "document": {"schemaVersion": 1, "speciesId": "sprout", "evolutions": [{"targetSpeciesId": "aurora", "method": "level", "minLevel": 16}]}},
          "observations": [
            {"path": "data/pokemon/evolutions/sprout.json", "at": ["evolutions", 0, "targetSpeciesId"], "equals": "aurora"},
            {"path": "data/pokemon/evolutions/sprout.json", "at": ["evolutions", 0, "minLevel"], "equals": 16}
          ]
        },
        {
          "actionId": "pokemon.media.write",
          "actionVersion": 1,
          "parameters": {"relativePath": "data/pokemon/media/sprout.json", "document": {"schemaVersion": 1, "speciesId": "sprout", "defaultFormId": "base", "variants": {"base": {}}}},
          "observations": [
            {"path": "data/pokemon/media/sprout.json", "at": ["defaultFormId"], "equals": "base"},
            {"path": "data/pokemon/media/sprout.json", "at": ["speciesId"], "equals": "sprout"}
          ]
        },
        {
          "actionId": "pokemon.documents.write",
          "actionVersion": 1,
          "parameters": {"documents": [{"actionId": "pokemon.species.write", "parameters": {"relativePath": "data/pokemon/species/creek.json", "document": {"schemaVersion": 1, "id": "creek", "name": {"en": "Creek"}, "typing": {"types": ["grass"]}, "baseStats": {"hp": 48, "atk": 47, "def": 46, "spa": 45, "spd": 44, "spe": 43}, "abilities": {"primary": "chord"}, "progression": {"growthRateId": "medium_slow", "baseExp": 60, "catchRate": 100}}}}, {"actionId": "pokemon.learnset.write", "parameters": {"relativePath": "data/pokemon/learnsets/creek.json", "document": {"schemaVersion": 1, "speciesId": "creek", "startingMoves": ["echo"]}}}]},
          "observations": [
            {"path": "data/pokemon/species/creek.json", "at": ["id"], "equals": "creek"},
            {"path": "data/pokemon/learnsets/creek.json", "at": ["startingMoves"], "equals": ["echo"]}
          ]
        }
      ]
    },
