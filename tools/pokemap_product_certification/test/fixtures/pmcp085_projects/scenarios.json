    {
      "id": "map-spatial-tools",
      "projectRoot": "map-spatial-tools",
      "steps": [
        {
          "actionId": "map3d.terrain.configure_height",
          "actionVersion": 1,
          "revisionScope": "project",
          "parameters": {"mapId": "map", "levelHeight": 0.25},
          "observations": [
            {"path": "maps/map.json", "at": ["spatialScene", "levelHeight"], "equals": 0.25}
          ]
        },
        {
          "actionId": "map3d.terrain.set_levels",
          "actionVersion": 1,
          "revisionScope": "project",
          "parameters": {"mapId": "map", "cells": [{"x": 0, "z": 0, "level": 2}, {"x": 1, "z": 1, "level": 4}]},
          "observations": [
            {"path": "maps/map.json", "at": ["spatialScene", "heightLevels", 0], "equals": 2},
            {"path": "maps/map.json", "at": ["spatialScene", "heightLevels", 7], "equals": 4},
            {"path": "maps/map.json", "at": ["spatialScene", "heightLevels", 8], "equals": 1}
          ]
        },
        {
          "actionId": "map3d.terrain.configure_appearance",
          "actionVersion": 1,
          "revisionScope": "project",
          "parameters": {"mapId": "map", "generateCliffs": false, "cliffFrame": null},
          "observations": [
            {"path": "maps/map.json", "at": ["spatialScene", "generateCliffs"], "equals": false}
          ]
        },
        {
          "actionId": "map3d.instance.visibility.set",
          "actionVersion": 1,
          "parameters": {"mapId": "map", "instanceId": "old-tree", "visibilityCondition": {"kind": "all", "children": []}},
          "observations": [
            {"path": "maps/map.json", "at": ["spatialScene", "instances", 0, "visibilityCondition"], "equals": {"kind": "all", "children": []}}
          ]
        },
        {
          "actionId": "map3d.instance.delete",
          "actionVersion": 1,
          "revisionScope": "project",
          "parameters": {"mapId": "map", "instanceId": "old-tree"},
          "observations": [
            {"path": "maps/map.json", "at": ["spatialScene", "instances"], "equals": []}
          ]
