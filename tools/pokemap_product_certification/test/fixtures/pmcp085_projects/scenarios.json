    {
      "id": "cinematic-timeline",
      "projectRoot": "cinematic-timeline",
      "steps": [
        {
          "actionId": "cinematic.upsert",
          "actionVersion": 1,
          "parameters": {"cinematic": {"id": "hillside", "title": "Hillside", "requiredActors": [{"actorId": "hero", "label": "Guide"}], "timeline": {"steps": [{"id": "short-wait", "kind": "wait", "durationMs": 100}, {"id": "second-wait", "kind": "wait", "durationMs": 300}, {"id": "final-wait", "kind": "wait", "durationMs": 700}]}}},
          "observations": [
            {"path": "project.json", "at": ["cinematics", 0, "title"], "equals": "Hillside"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 0, "durationMs"], "equals": 100}
          ]
        },
        {
          "actionId": "cinematic.timeline_move",
          "actionVersion": 1,
          "parameters": {"cinematicId": "hillside", "stepIds": ["short-wait"], "insertionIndex": 3},
          "observations": [
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 0, "id"], "equals": "second-wait"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 2, "id"], "equals": "short-wait"}
          ]
        },
        {
          "actionId": "cinematic.timeline_duplicate",
          "actionVersion": 1,
          "parameters": {"cinematicId": "hillside", "stepIds": ["second-wait"]},
          "observations": [
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 1, "id"], "equals": "second-wait_copy"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 1, "durationMs"], "equals": 300}
          ]
        },
        {
          "actionId": "cinematic.timeline_paste",
          "actionVersion": 1,
          "parameters": {"cinematicId": "hillside", "insertionIndex": 0, "clipboard": {"schemaVersion": 1, "steps": [{"id": "pause", "kind": "wait", "durationMs": 950}]}},
          "observations": [
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 0, "id"], "equals": "pause_copy"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 0, "durationMs"], "equals": 950}
          ]
        },
        {
          "actionId": "cinematic.timeline_delete",
          "actionVersion": 1,
          "confirm": true,
          "parameters": {"cinematicId": "hillside", "stepIds": ["pause_copy", "second-wait_copy"]},
          "observations": [
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 0, "id"], "equals": "second-wait"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 3], "absent": true}
          ]
        },
        {
          "actionId": "cinematic.character_animation.upsert",
          "actionVersion": 1,
          "parameters": {"cinematicId": "hillside", "stepId": "wave-step", "afterStepId": "short-wait", "label": "Wave to the path", "runtimeCommand": {"actorId": "hero", "definitionId": "wave", "direction": "north", "playback": {"kind": "once"}, "interruptionPolicy": "replaceActive", "fallbackPolicy": "fail"}},
          "observations": [
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 3, "id"], "equals": "wave-step"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 3, "kind"], "equals": "actorAnimation"},
            {"path": "project.json", "at": ["cinematics", 0, "timeline", "steps", 3, "actorId"], "equals": "hero"}
          ]
        },
        {
          "actionId": "cinematic.delete",
          "actionVersion": 1,
          "confirm": true,
          "parameters": {"cinematicId": "hillside"},
          "observations": [
            {"path": "project.json", "at": ["cinematics"], "equals": []}
          ]
        }
      ]
    },
