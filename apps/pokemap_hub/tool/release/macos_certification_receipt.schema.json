{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemap.app/schemas/macos-certification-receipt-v1.json",
  "title": "PokeMap Hub macOS certification receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "appVersion",
    "buildNumber",
    "artifactSha256",
    "artifactBytes",
    "architectures",
    "notarySubmissionId",
    "neutralPackageSha256",
    "repositoryAbsent",
    "networkDisabled",
    "signedWithDeveloperId",
    "hardenedRuntime",
    "notarized",
    "stapled",
    "gatekeeperAccepted",
    "coldInstalled",
    "relaunched",
    "createdAt"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "bundleId": { "const": "app.pokemap.hub" },
    "appVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "buildNumber": { "type": "string", "pattern": "^[1-9][0-9]*$" },
    "artifactSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "artifactBytes": { "type": "integer", "minimum": 1 },
    "architectures": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["arm64", "x86_64"] }
    },
    "notarySubmissionId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "neutralPackageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "repositoryAbsent": { "const": true },
    "networkDisabled": { "const": true },
    "signedWithDeveloperId": { "const": true },
    "hardenedRuntime": { "const": true },
    "notarized": { "const": true },
    "stapled": { "const": true },
    "gatekeeperAccepted": { "const": true },
    "coldInstalled": { "const": true },
    "relaunched": { "const": true },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
