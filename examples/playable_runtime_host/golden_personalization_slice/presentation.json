{
  "schemaVersion": 5,
  "branding": {
    "iconPath": "assets/presentation/icon.png",
    "coverPath": "assets/presentation/cover.png",
    "heroPath": "assets/presentation/hero.png",
    "accentColor": "#003A44",
    "titleMusicPath": "assets/presentation/title.ogg",
    "layoutVariant": "cinematic"
  },
  "intro": {
    "media": {
      "landscape": {
        "videoPath": "assets/presentation/intro/intro.mp4",
        "posterPath": "assets/presentation/intro/poster.png",
        "captionsPath": "assets/presentation/intro/captions.vtt",
        "durationMilliseconds": 1000,
        "width": 1280,
        "height": 720,
        "bitrateKbps": 128,
        "sizeBytes": 28,
        "videoCodec": "h264",
        "audioCodec": "aac",
        "focalX": 0.5,
        "focalY": 0.5
      }
    },
    "reducedMotionBehavior": "poster",
    "allowReplay": true
  },
  "titleMotion": {
    "promptLoop": {
      "landscape": {
        "videoPath": "assets/presentation/intro/intro.mp4",
        "posterPath": "assets/presentation/intro/poster.png",
        "durationMilliseconds": 1000,
        "width": 1280,
        "height": 720,
        "bitrateKbps": 128,
        "sizeBytes": 28,
        "videoCodec": "h264",
        "audioCodec": "none",
        "focalX": 0.5,
        "focalY": 0.5
      }
    }
  },
  "typography": {
    "display": {
      "fontPath": "assets/presentation/fonts/display.ttf",
      "family": "Aube Display",
      "licensePath": "assets/presentation/fonts/display-license.txt",
      "redistributable": true,
      "fallbackFamilies": [
        "sans-serif"
      ],
      "glyphCoverage": [
        "latin",
        "latinExtended",
        "digits",
        "punctuation"
      ]
    },
    "body": {
      "fallbackFamilies": [
        "sans-serif"
      ]
    },
    "dialogue": {
      "fallbackFamilies": [
        "sans-serif"
      ]
    },
    "combat": {
      "fallbackFamilies": [
        "monospace"
      ]
    },
    "numbers": {
      "fallbackFamilies": [
        "monospace"
      ]
    }
  },
  "theme": {
    "primary": "#003A44",
    "onPrimary": "#FFFFFF",
    "background": "#F4F7FB",
    "surface": "#FFFFFF",
    "surfaceElevated": "#EAF0F8",
    "textPrimary": "#101827",
    "textSecondary": "#526176",
    "outline": "#65758B",
    "success": "#16794B",
    "warning": "#8A5100",
    "danger": "#B4233C",
    "titleSurface": "#D9F4F6",
    "dialogueSurface": "#FFFFFF",
    "menuSurface": "#EAF0F8",
    "overworldHudSurface": "#FFFFFF",
    "battleHudSurface": "#FFFFFF"
  },
  "menuLabels": {
    "pauseTitle": "Escale",
    "resume": "Reprendre le voyage",
    "party": "Compagnons",
    "bag": "Sac de voyage",
    "pokedex": "Carnet de route",
    "map": "Itinéraire",
    "save": "Consigner",
    "options": "Réglages",
    "returnToTitle": "Quitter le train"
  },
  "windows": {
    "styles": [
      {
        "id": "default",
        "fillToken": "surfaceElevated",
        "borderToken": "outline",
        "borderWidth": 1,
        "cornerRadius": 18,
        "contentPadding": 20,
        "shadowElevation": 6
      },
      {
        "id": "pause-menu",
        "fillToken": "menuSurface",
        "borderToken": "primary",
        "borderWidth": 2,
        "cornerRadius": 24,
        "contentPadding": 20,
        "shadowElevation": 12
      },
      {
        "id": "dialogue",
        "fillToken": "dialogueSurface",
        "borderToken": "primary",
        "borderWidth": 2,
        "cornerRadius": 8,
        "contentPadding": 12,
        "shadowElevation": 4
      },
      {
        "id": "battle",
        "fillToken": "battleHudSurface",
        "borderToken": "danger",
        "borderWidth": 3,
        "cornerRadius": 12,
        "contentPadding": 14,
        "shadowElevation": 6
      }
    ],
    "defaultStyleId": "default",
    "pauseMenuStyleId": "pause-menu",
    "dialogueStyleId": "dialogue",
    "battleStyleId": "battle",
    "pauseBackdropOpacity": 0.8
  },
  "layouts": {
    "title": {
      "compact": {
        "breakpoint": "compact",
        "slot": "bottomCenter",
        "width": "comfortable",
        "spacing": "normal",
        "screenMargin": "compact",
        "visibleSecondaryElements": ["titleLogo", "titleAuthor"]
      },
      "regular": {
        "breakpoint": "regular",
        "slot": "bottomLeft",
        "width": "comfortable",
        "spacing": "normal",
        "screenMargin": "compact",
        "visibleSecondaryElements": [
          "titleLogo",
          "titleAuthor",
          "titleDescription"
        ]
      },
      "expanded": {
        "breakpoint": "expanded",
        "slot": "bottomLeft",
        "width": "narrow",
        "spacing": "airy",
        "screenMargin": "comfortable",
        "visibleSecondaryElements": [
          "titleLogo",
          "titleAuthor",
          "titleDescription"
        ]
      }
    },
    "pauseMenu": {
      "compact": {
        "breakpoint": "compact",
        "slot": "fullScreen",
        "width": "wide",
        "spacing": "compact",
        "screenMargin": "none",
        "visibleSecondaryElements": ["pauseGameTitle"]
      },
      "regular": {
        "breakpoint": "regular",
        "slot": "left",
        "width": "comfortable",
        "spacing": "normal",
        "screenMargin": "compact",
        "visibleSecondaryElements": ["pauseGameTitle"]
      },
      "expanded": {
        "breakpoint": "expanded",
        "slot": "leftPane",
        "width": "narrow",
        "spacing": "airy",
        "screenMargin": "comfortable",
        "visibleSecondaryElements": ["pauseGameTitle"]
      }
    },
    "dialogue": {
      "compact": {
        "breakpoint": "compact",
        "slot": "bottomCenter",
        "width": "wide",
        "spacing": "compact",
        "screenMargin": "compact",
        "visibleSecondaryElements": ["dialoguePortrait"]
      },
      "regular": {
        "breakpoint": "regular",
        "slot": "bottomCenter",
        "width": "wide",
        "spacing": "normal",
        "screenMargin": "compact",
        "visibleSecondaryElements": ["dialoguePortrait"]
      },
      "expanded": {
        "breakpoint": "expanded",
        "slot": "bottomCenter",
        "width": "comfortable",
        "spacing": "airy",
        "screenMargin": "comfortable",
        "visibleSecondaryElements": ["dialoguePortrait"]
      }
    },
    "battle": {
      "compact": {
        "breakpoint": "compact",
        "slot": "bottomCenter",
        "width": "wide",
        "spacing": "compact",
        "screenMargin": "none",
        "visibleSecondaryElements": []
      },
      "regular": {
        "breakpoint": "regular",
        "slot": "right",
        "width": "narrow",
        "spacing": "compact",
        "screenMargin": "compact",
        "visibleSecondaryElements": []
      },
      "expanded": {
        "breakpoint": "expanded",
        "slot": "right",
        "width": "narrow",
        "spacing": "normal",
        "screenMargin": "comfortable",
        "visibleSecondaryElements": []
      }
    }
  }
}
