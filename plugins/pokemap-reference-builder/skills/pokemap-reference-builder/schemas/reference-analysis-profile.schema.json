{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemap.local/schemas/reference-analysis-profile.schema.json",
  "title": "PokeMap assisted reference analysis profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "cellSizePx", "classes"],
  "properties": {
    "schemaVersion": {"const": 1},
    "cellSizePx": {"const": 32},
    "sourceCellSizePx": {"type": "integer", "minimum": 1},
    "sampleInsetPx": {"type": "integer", "minimum": 0},
    "classes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/semanticClass"}
    },
    "missingAssets": {
      "type": "array",
      "items": {"$ref": "exterior-map-blueprint.schema.json#/$defs/missingAsset"}
    }
  },
  "$defs": {
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"type": "integer", "minimum": 0},
        "y": {"type": "integer", "minimum": 0}
      }
    },
    "semanticClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semantic", "name", "seeds"],
      "properties": {
        "semantic": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "family": {"enum": ["surface", "network", "border", "structure", "decoration", "navigation"]},
        "seeds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cell"}},
        "minimumConfidence": {"type": "number", "minimum": 0, "maximum": 1},
        "minimumComponentCells": {"type": "integer", "minimum": 1},
        "constraints": {"type": "object"},
        "notes": {"type": "array", "items": {"type": "string"}}
      }
    }
  }
}
