{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemap.dev/schemas/save-envelope-v1.schema.json",
  "title": "PokeMap Save Envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "gameId",
    "profileId",
    "slotId",
    "saveId",
    "createdAt",
    "updatedAt",
    "gameVersion",
    "projectFormat",
    "saveFormat",
    "compatibilityId",
    "status",
    "playTimeSeconds",
    "state",
    "checksum"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "gameId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"
    },
    "profileId": { "$ref": "#/$defs/localId" },
    "slotId": { "$ref": "#/$defs/localId" },
    "saveId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "createdAt": { "$ref": "#/$defs/utcTimestamp" },
    "updatedAt": { "$ref": "#/$defs/utcTimestamp" },
    "gameVersion": { "$ref": "#/$defs/semver" },
    "projectFormat": {
      "type": "string",
      "enum": ["v1", "v2"]
    },
    "saveFormat": { "const": 1 },
    "compatibilityId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "status": {
      "type": "string",
      "enum": ["active", "completed"]
    },
    "completedAt": { "$ref": "#/$defs/utcTimestamp" },
    "playTimeSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3155760000
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "importedAt"],
      "properties": {
        "kind": { "enum": ["legacy-global-save", "manual-import"] },
        "importedAt": { "$ref": "#/$defs/utcTimestamp" }
      }
    },
    "state": {
      "type": "object"
    },
    "checksum": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "value"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "value": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "status": { "const": "completed" } },
        "required": ["status"]
      },
      "then": { "required": ["completedAt"] }
    },
    {
      "if": {
        "properties": { "status": { "const": "active" } },
        "required": ["status"]
      },
      "then": {
        "not": { "required": ["completedAt"] }
      }
    }
  ],
  "$defs": {
    "localId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "utcTimestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    }
  }
}
