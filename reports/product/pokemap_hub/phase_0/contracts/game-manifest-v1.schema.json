{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pokemap.dev/schemas/game-manifest-v1.schema.json",
  "title": "PokeMap Game Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "packageFormat",
    "gameId",
    "gameVersion",
    "title",
    "author",
    "compatibility",
    "locales",
    "content"
  ],
  "properties": {
    "packageFormat": { "const": 1 },
    "gameId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9-]*(\\.[a-z][a-z0-9-]*){2,}$"
    },
    "gameVersion": { "$ref": "#/$defs/semver" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 4000 },
    "author": { "$ref": "#/$defs/party" },
    "publisher": { "$ref": "#/$defs/party" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minHubVersion",
        "runtimeApi",
        "projectFormat",
        "saveFormat",
        "compatibilityId",
        "requiredCapabilities"
      ],
      "properties": {
        "minHubVersion": { "$ref": "#/$defs/semver" },
        "runtimeApi": { "$ref": "#/$defs/semverRange" },
        "projectFormat": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "saveFormat": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "compatibilityId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "requiredCapabilities": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/capability" }
        }
      }
    },
    "locales": {
      "type": "object",
      "additionalProperties": false,
      "required": ["default", "supported"],
      "properties": {
        "default": { "$ref": "#/$defs/locale" },
        "supported": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/locale" }
        }
      }
    },
    "branding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "icon": { "$ref": "#/$defs/packagePath" },
        "cover": { "$ref": "#/$defs/packagePath" },
        "hero": { "$ref": "#/$defs/packagePath" },
        "accentColor": {
          "type": "string",
          "pattern": "^#[0-9A-Fa-f]{6}([0-9A-Fa-f]{2})?$"
        },
        "titleMusic": { "$ref": "#/$defs/packagePath" },
        "layoutVariant": {
          "type": "string",
          "enum": ["standard", "centered", "cinematic"]
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileCount", "totalBytes", "treeSha256", "files"],
      "properties": {
        "fileCount": { "type": "integer", "minimum": 1, "maximum": 20000 },
        "totalBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "treeSha256": { "$ref": "#/$defs/sha256" },
        "files": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20000,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "size", "sha256"],
            "properties": {
              "path": { "$ref": "#/$defs/packagePath" },
              "size": {
                "type": "integer",
                "minimum": 0,
                "maximum": 268435456
              },
              "sha256": { "$ref": "#/$defs/sha256" },
              "mediaType": {
                "type": "string",
                "minLength": 1,
                "maxLength": 127,
                "pattern": "^[a-z0-9!#$&^_.+-]+/[a-z0-9!#$&^_.+-]+$"
              }
            }
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "keyId", "value"],
      "properties": {
        "algorithm": { "const": "ed25519" },
        "keyId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "value": {
          "type": "string",
          "minLength": 88,
          "maxLength": 88,
          "contentEncoding": "base64"
        }
      }
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "semverRange": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "party": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://",
          "maxLength": 2048
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35,
      "pattern": "^[A-Za-z]{2,3}(?:-[A-Za-z0-9]{2,8})*$"
    },
    "capability": {
      "type": "string",
      "minLength": 3,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9.-]*@[1-9][0-9]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "packagePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)(?!.*[\\u0000-\\u001F\\u007F])(project|presentation|legal)/.+$"
    }
  }
}
