  "decisions": [
    {
      "id": "CIN-ADR-001",
      "title": "Project version and capability gate",
      "ownerPackages": [
        "map_core"
      ],
      "consequence": "CIN-V2 project data requires V7 and old runtimes reject it before execution.",
      "verificationTickets": [
        "BETA-CIN-013",
        "BETA-CIN-042"
      ]
    },
    {
      "id": "CIN-ADR-002",
      "title": "Disjoint cinematic asset families",
      "ownerPackages": [
        "map_core"
      ],
      "consequence": "World and Presentation assets never share a nullable polymorphic model or identifier namespace.",
      "verificationTickets": [
        "BETA-CIN-002"
      ]
    },
    {
      "id": "CIN-ADR-003",
      "title": "Scene profiles and capability matrix",
      "ownerPackages": [
        "map_core",
        "map_authoring"
      ],
      "consequence": "Build, validation and runtime consume one fail-closed preSession capability matrix.",
      "verificationTickets": [
        "BETA-CIN-003",
        "BETA-CIN-006"
      ]
    },
    {
      "id": "CIN-ADR-004",
      "title": "Structured awaitable inputs",
      "ownerPackages": [
        "map_core",
        "map_player_ui"
      ],
      "consequence": "Scene execution exchanges typed requests and results, never raw input characters.",
      "verificationTickets": [
        "BETA-CIN-004",
        "BETA-CIN-039"
      ]
    },
    {
      "id": "CIN-ADR-005",
      "title": "Absolute deterministic timeline",
      "ownerPackages": [
        "map_core"
      ],
      "consequence": "All tracks share integer microseconds and half-open clip intervals.",
      "verificationTickets": [
        "BETA-CIN-002",
        "BETA-CIN-015"
      ]
    },
    {
      "id": "CIN-ADR-006",
      "title": "Exactly-once execution outcome",
      "ownerPackages": [
        "map_core",
        "map_runtime"
      ],
      "consequence": "Every execution emits one completed, skipped, cancelled or failed terminal outcome.",
      "verificationTickets": [
        "BETA-CIN-005",
        "BETA-CIN-017"
      ]
    },
    {
      "id": "CIN-ADR-007",
      "title": "Transactional New Game pipeline",
      "ownerPackages": [
        "map_core",
        "map_gameplay",
        "map_runtime"
      ],
      "consequence": "Draft creation, seed projection and GameState persistence are separated and commit exactly once.",
      "verificationTickets": [
        "BETA-CIN-016",
        "BETA-CIN-045"
      ]
    },
    {
      "id": "CIN-ADR-008",
      "title": "Single preSession entrypoint and controlled migration",
      "ownerPackages": [
        "map_core",
        "map_authoring"
      ],
      "consequence": "Runtime reads only preSessionSceneId; starterSelectionSceneId can be converted only by an explicit compatible offline operation.",
      "verificationTickets": [
        "BETA-CIN-013",
        "BETA-CIN-043"
      ]
    },
    {
      "id": "CIN-ADR-009",
      "title": "preSession lifecycle and preload boundary",
      "ownerPackages": [
        "map_runtime"
      ],
      "consequence": "Slot and overwrite are resolved first; preload cannot create world or save state and is disposed on non-completion.",
      "verificationTickets": [
        "BETA-CIN-034",
        "BETA-CIN-040"
      ]
    },
    {
      "id": "CIN-ADR-010",
      "title": "Single audio and media lifecycle authority",
      "ownerPackages": [
        "map_runtime",
        "map_player_ui"
      ],
      "consequence": "Video audio is muted or mixer-managed and every decoder/cache handle follows runtime lifecycle disposal.",
      "verificationTickets": [
        "BETA-CIN-018",
        "BETA-CIN-032"
      ]
    },
    {
      "id": "CIN-ADR-011",
      "title": "Transactional secure media catalog",
      "ownerPackages": [
        "map_authoring",
        "map_distribution"
      ],
      "consequence": "Stable logical media IDs, content hashes, atomic import and reference-aware deletion protect package integrity.",
      "verificationTickets": [
        "BETA-CIN-014",
        "BETA-CIN-028",
        "BETA-CIN-029"
      ]
    },
    {
      "id": "CIN-ADR-012",
      "title": "Shared evaluator and renderer",
      "ownerPackages": [
        "map_core",
        "map_player_ui",
        "map_editor"
      ],
      "consequence": "Runtime and Studio preview use the same renderer semantics and differ only by their clock source.",
      "verificationTickets": [
        "BETA-CIN-015",
        "BETA-CIN-017",
        "BETA-CIN-020"
      ]
    },
    {
      "id": "CIN-ADR-013",
      "title": "Four-transport semantic authoring parity",
      "ownerPackages": [
        "map_authoring",
        "map_editor"
      ],
      "consequence": "Direct API, JSONL/CLI, Editor and MCP expose the same Presentation and preSession semantics.",
      "verificationTickets": [
        "BETA-CIN-006",
        "BETA-CIN-019",
        "BETA-CIN-044"
      ]
    },
    {
      "id": "CIN-ADR-014",
      "title": "Accessibility and input are contract requirements",
      "ownerPackages": [
        "map_core",
        "map_player_ui",
        "map_editor"
      ],
      "consequence": "Reduced motion and flashes, captions, focus and all supported input families are certifiable behavior.",
      "verificationTickets": [
        "BETA-CIN-011",
        "BETA-CIN-039",
        "BETA-CIN-041"
      ]
    },
    {
      "id": "CIN-ADR-015",
      "title": "Stable diagnostics and privacy",
      "ownerPackages": [
        "map_core",
        "map_runtime",
        "map_authoring"
      ],
      "consequence": "Stable codes correlate execution without recording names, authored text, captions or absolute paths.",
      "verificationTickets": [
        "BETA-CIN-030",
        "BETA-CIN-033"
      ]
    },
    {
      "id": "CIN-ADR-016",
      "title": "Measured performance and platform promotion",
      "ownerPackages": [
        "map_runtime",
        "map_distribution"
      ],
      "consequence": "Budgets and platform support are promoted only by fresh lifecycle, build and packaging evidence.",
      "verificationTickets": [
        "BETA-CIN-032",
        "BETA-CIN-047",
        "BETA-LCH-001"
      ]
    },
    {
      "id": "CIN-ADR-017",
      "title": "Canary-first strict legacy cutover",
      "ownerPackages": [
        "map_core",
        "map_runtime",
        "map_authoring",
        "map_editor"
      ],
      "consequence": "Legacy readers, writers, bridges and fallbacks are removed only after canary proof and never survive the cutover gate.",
      "verificationTickets": [
        "BETA-CIN-042",
        "BETA-CIN-043",
        "BETA-CIN-044",
        "BETA-CIN-010"
      ]
    }
  ]
