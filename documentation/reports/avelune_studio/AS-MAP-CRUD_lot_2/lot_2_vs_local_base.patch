+          value: width,
+          label: 'Largeur (cases)',
+          enabled: !busy && !published,
+          errorText: positive(width) == null ? 'Entier positif requis' : null,
+          onChanged: (value) {
+            width = value;
+            preparation = null;
+            error = null;
+            refresh();
+          },
+        ),
+        const SizedBox(height: 12),
+        StudioDraftField(
+          key: const ValueKey('resize-map-height'),
+          value: height,
+          label: 'Hauteur (cases)',
+          enabled: !busy && !published,
+          errorText: positive(height) == null ? 'Entier positif requis' : null,
+          onChanged: (value) {
+            height = value;
+            preparation = null;
+            error = null;
+            refresh();
+          },
