+    final duplication = await _measureLifecycle(
+      controller,
+      fixture,
+      source,
+      phase,
+      'duplicate.prepare',
+      profiles,
+      () => controller.prepareCatalog('map.duplicate', {
+        'sourceMapId': original.id,
+        'name': '${original.name} — copie de mesure',
+      }),
+    );
