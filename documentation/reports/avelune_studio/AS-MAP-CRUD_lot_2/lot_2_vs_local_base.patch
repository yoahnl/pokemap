+        ),
+        const SizedBox(height: 12),
+        StudioButton(
+          label: 'Analyser les conséquences',
+          secondary: true,
+          icon: Icons.search,
+          loading: analyzing,
+          onPressed:
+              busy ||
+                  published ||
+                  source == null ||
+                  positive(width) == null ||
+                  positive(height) == null
