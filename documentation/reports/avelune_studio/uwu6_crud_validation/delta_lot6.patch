+          .gameExport!;
+  print(
+    'UWU6_RESOURCE_EXPORT_START stage=${owner.stage} busy=${owner.busy} canStart=${owner.canStart} error=${owner.error}',
+  );
+  for (var i = 0; i < 200 && owner.outputPath == null; i++) {
+    await pumpIo(tester, frames: 2);
+    if (owner.error != null) break;
