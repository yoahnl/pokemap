+Future<void> _until(PlayableMapGame game, bool Function() done) async {
+  for (var i = 0; i < 300; i++) {
+    if (done()) return;
+    game.update(.016);
+    await Future<void>.delayed(Duration.zero);
+  }
+  throw StateError('Installed Player did not reach the expected state.');
+}
